# Copy to .env and adjust. docker compose reads it automatically.

# Your user id (run: id -u), so files Airflow writes into site/ belong to you.
AIRFLOW_UID=1000

# Credentials for the local S3 store. Any values work; they only protect your laptop.
RAIN_WATCH_S3_KEY_ID=rainwatch
RAIN_WATCH_S3_SECRET=change-me-to-something-long

# Optional: an ntfy.sh topic for phone alerts. Pick a long random name, since anyone who
# knows it can read the alerts. Leave empty to only log them.
RAIN_WATCH_NTFY_TOPIC=
